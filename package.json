    "nodemailer": "^8.0.10",
    "playwright": "^1.59.1",
    "postgres": "^3.4.9",
    "svelte": "^5.55.2",
    "svelte-chartjs": "^4.0.1",
    "svelte-check": "^4.4.6",
    "tippy.js": "^6.3.7",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.7",
    "vitest": "^4.1.3",
    "vitest-browser-svelte": "^2.1.0",
    "xlsx": "^0.18.5"
  }
